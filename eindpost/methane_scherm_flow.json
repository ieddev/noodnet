    {
        "id": "52b133fc29d3c0f7",
        "type": "ui_template",
        "z": "01dadc161e213217",
        "group": "mth_grp_melding",
        "name": "Huidige melding",
        "order": 1,
        "width": 24,
        "height": 14,
        "format": "<style>\n.mth { box-sizing:border-box; height:100%; overflow:auto; background:#1b1f24; color:#fff; font-family:Arial, Helvetica, sans-serif; padding:16px; border-radius:8px; }\n.mth-leeg { font-size:2em; color:#8a8f96; padding:60px 20px; text-align:center; }\n.mth-kop { display:flex; justify-content:space-between; align-items:center; gap:20px;\n           padding:16px 24px; border-radius:8px; background:#d35400; }\n.mth-kop.hoog { background:#c0392b; }\n.mth-kop .titel { font-size:2.6em; font-weight:bold; line-height:1.1; }\n.mth-kop .sub { font-size:1.2em; opacity:.85; margin-bottom:4px; letter-spacing:.05em; }\n.mth-kop .info { text-align:right; font-size:1.4em; white-space:nowrap; }\n.mth-knipper { animation: mthknip 1s step-start 0s 30; }\n@keyframes mthknip { 50% { background:#ffffff; color:#c0392b; } }\n.mth-grid { display:grid; grid-template-columns:80px minmax(180px, 260px) 1fr; gap:8px 18px; margin-top:16px; }\n.mth-letter { font-size:2.6em; font-weight:bold; text-align:center; background:#2c3e50;\n              border-radius:6px; display:flex; align-items:center; justify-content:center; }\n.mth-label { font-size:1.3em; color:#aeb4bb; align-self:center; }\n.mth-waarde { font-size:1.9em; white-space:pre-line; align-self:center; line-height:1.25; }\n.mth-waarde.onbekend { color:#6f757c; font-style:italic; }\n.mth-voet { margin-top:14px; color:#aeb4bb; font-size:1.05em; }\n.mth-voet .upd { color:#f1c40f; }\n</style>\n\n<div class=\"mth\">\n  <div ng-if=\"!msg.payload\" class=\"mth-leeg\">Nog geen M/ETHANE-melding ontvangen</div>\n\n  <div ng-if=\"msg.payload\" ng-repeat=\"p in [msg.payload] track by msg.versie\">\n    <div class=\"mth-kop\" ng-class=\"{'hoog': p.prioriteit == 'hoog', 'mth-knipper': msg.nieuw}\">\n      <div>\n        <div class=\"sub\">M/ETHANE MELDING{{ p.prioriteit == 'hoog' ? ' – GROOT INCIDENT' : '' }}</div>\n        <div class=\"titel\">{{ p.soort_incident }}</div>\n      </div>\n      <div class=\"info\">{{ p.melding_tijd }}<br>Meldcode {{ p.meldcode }}</div>\n    </div>\n\n    <div class=\"mth-grid\">\n      <div ng-repeat-start=\"r in p.regels\" class=\"mth-letter\">{{ r.letter }}</div>\n      <div class=\"mth-label\">{{ r.label.substring(4) }}</div>\n      <div ng-repeat-end class=\"mth-waarde\" ng-class=\"{'onbekend': r.onbekend}\">{{ r.waarde }}</div>\n    </div>\n\n    <div class=\"mth-voet\">\n      Gemeld aan: {{ p.gemeld_aan }}\n      · Van {{ p.afzender_naam || ((p.afzender | limitTo:8) + '…') }}\n      <span ng-if=\"p.steunpunt\">· via {{ p.steunpunt }}</span>\n      <span ng-if=\"p.rssi !== null\">· RSSI {{ p.rssi }} dBm</span>\n      <span ng-if=\"p.snr !== null\">· SNR {{ p.snr }} dB</span>\n      <span ng-if=\"p.herhaling\" class=\"upd\">· bijgewerkt door herhaalde verzending</span>\n    </div>\n  </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 780,
        "y": 220,
        "wires": [
            []
        ]
    },
    {
        "id": "055a899b62e58290",
        "type": "ui_template",
        "z": "01dadc161e213217",
        "group": "mth_grp_lijst",
        "name": "Laatste meldingen",
        "order": 1,
        "width": 24,
        "height": 14,
        "format": "<style>\n.mth-tab { width:100%; border-collapse:collapse; font-family:Arial, Helvetica, sans-serif; font-size:1.15em; }\n.mth-tab th { text-align:left; padding:8px; background:#2c3e50; color:#fff; }\n.mth-tab td { padding:8px; border-bottom:1px solid #444; vertical-align:top; }\n.mth-tab tr.rij { cursor:pointer; }\n.mth-tab tr.rij:hover td { background:rgba(128,128,128,.18); }\n.mth-tab tr.hoog td:first-child { border-left:6px solid #c0392b; }\n.mth-tab tr.normaal td:first-child { border-left:6px solid #d35400; }\n.mth-tab td:nth-child(1), .mth-tab td:nth-child(3) { white-space:nowrap; }\n.mth-tab .leeg { color:#888; font-style:italic; }\n.mth-tab .pijl { display:inline-block; width:1.1em; color:#aeb4bb; }\n.mth-tab tr.detail td { background:#151a1f; color:#ffffff; padding:12px 18px 16px 18px; }\n.mth-dgrid { display:grid; grid-template-columns:44px minmax(150px, 220px) 1fr; gap:6px 14px; }\n.mth-dl { font-size:1.4em; font-weight:bold; text-align:center; background:#2c3e50; color:#ffffff; border-radius:4px; }\n.mth-dlab { color:#aeb4bb; align-self:center; }\n.mth-dw { white-space:pre-line; align-self:center; font-size:1.1em; }\n.mth-dw.onbekend { color:#6f757c; font-style:italic; }\n.mth-dvoet { margin-top:10px; color:#aeb4bb; }\n.mth-hint { color:#8a8f96; font-size:0.9em; margin:4px 0 8px 0; }\n</style>\n<div ng-init=\"open = {}\">\n  <div class=\"mth-hint\">Klik op een melding om alle M/ETHANE-velden te zien.</div>\n  <table class=\"mth-tab\">\n    <tr><th>Tijd</th><th>Van</th><th>Meldcode</th><th>Soort</th><th>Locatie</th><th>Slachtoffers</th><th>Groot</th></tr>\n    <tr ng-if=\"!msg.payload || msg.payload.length == 0\"><td colspan=\"7\" class=\"leeg\">Geen meldingen</td></tr>\n    <tr ng-repeat-start=\"m in msg.payload track by $index\" class=\"rij\"\n        ng-class=\"m.prioriteit == 'hoog' ? 'hoog' : 'normaal'\"\n        ng-click=\"open[m.meldcode + '|' + m.afzender] = !open[m.meldcode + '|' + m.afzender]\">\n      <td><span class=\"pijl\">{{ open[m.meldcode + '|' + m.afzender] ? '▾' : '▸' }}</span>{{ m.melding_tijd }}</td>\n      <td>{{ m.afzender_naam || 'onbekend' }}</td>\n      <td>{{ m.meldcode }}</td>\n      <td>{{ m.soort_incident }}</td>\n      <td>{{ m.locatie }}</td>\n      <td>{{ m.slachtoffers }}</td>\n      <td>{{ m.groot_incident }}</td>\n    </tr>\n    <tr ng-repeat-end ng-if=\"open[m.meldcode + '|' + m.afzender]\" class=\"detail\">\n      <td colspan=\"7\">\n        <div class=\"mth-dgrid\">\n          <div ng-repeat-start=\"r in m.regels\" class=\"mth-dl\">{{ r.letter }}</div>\n          <div class=\"mth-dlab\">{{ r.label.substring(4) }}</div>\n          <div ng-repeat-end class=\"mth-dw\" ng-class=\"{'onbekend': r.onbekend}\">{{ r.waarde }}</div>\n        </div>\n        <div class=\"mth-dvoet\">\n          Gemeld aan: {{ m.gemeld_aan }}\n          <span ng-if=\"m.steunpunt\">· via {{ m.steunpunt }}</span>\n          <span ng-if=\"m.rssi !== null && m.rssi !== undefined\">· RSSI {{ m.rssi }} dBm</span>\n          <span ng-if=\"m.snr !== null && m.snr !== undefined\">· SNR {{ m.snr }} dB</span>\n          <span ng-if=\"m.herhaling\">· bijgewerkt door herhaalde verzending</span>\n        </div>\n      </td>\n    </tr>\n  </table>\n</div>\n",
        "storeOutMessages": true,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 790,
        "y": 320,
