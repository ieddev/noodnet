    {
        "id": "a35c87e61b1159b4",
        "type": "function",
        "z": "01dadc161e213217",
        "name": "Verwerk melding",
        "func": "// Verwerkt M/ETHANE-meldingen van de gateway.\n// Uitgang 1: huidige melding (groot scherm)\n// Uitgang 2: lijst met de laatste meldingen\nconst p = msg.payload;\nif (!p || p.type !== \"METHANE\") return null;\n\nlet lijst = flow.get(\"methane_lijst\") || [];\nconst idx = lijst.findIndex(m => m.meldcode === p.meldcode && m.afzender === p.afzender);\nconst nieuw = idx === -1;\nif (nieuw) {\n    lijst.unshift(p);\n} else {\n    lijst[idx] = p;              // herhaalde verzending: bijwerken, geen nieuwe regel\n}\nlijst = lijst.slice(0, 25);       // laatste 25 bewaren\nflow.set(\"methane_lijst\", lijst);\n\n// Alleen knipperen bij een echt nieuwe melding, niet bij een herhaling\n// en niet bij het retained bericht dat binnenkomt na een herstart.\nconst alarm = nieuw && !p.herhaling && !msg.retain;\n\nnode.status({fill: p.prioriteit === \"hoog\" ? \"red\" : \"yellow\", shape: \"dot\",\n             text: p.meldcode + \" \" + (alarm ? \"NIEUW\" : \"bijgewerkt\")});\n\nreturn [\n    {payload: p, nieuw: alarm, versie: Date.now()},\n    {payload: lijst}\n];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 220,
        "wires": [
            [
                "52b133fc29d3c0f7"
            ],
            [
                "055a899b62e58290"
            ]
        ]
    },
