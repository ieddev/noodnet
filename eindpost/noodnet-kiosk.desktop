[Desktop Entry]
Type=Application
Name=Noodnet M/ETHANE-scherm
Comment=Opent het M/ETHANE-scherm schermvullend na het opstarten
Exec=sh -c 'sleep 25; B=$(command -v chromium-browser || command -v chromium); exec "$B" --kiosk --noerrdialogs --disable-infobars --no-first-run --password-store=basic --incognito http://localhost:1880/ui'
X-GNOME-Autostart-enabled=true
