--- /dev/null
+++ b/recipes/numpy/__init__.py
@@ -0,0 +1,20 @@
+# Noodnet: numpy 2.3.0 uit python-for-android (develop, okt 2025) is gemaakt voor
+# NDK 28c. Met de NDK 25b van Sideband mist unique.cpp de include van
+# <unordered_map>; die zetten we in de broncode. Verder ongewijzigd.
+from os.path import join, exists
+from pythonforandroid.recipes.numpy import NumpyRecipe
+
+
+class NoodnetNumpyRecipe(NumpyRecipe):
+    def prebuild_arch(self, arch):
+        super().prebuild_arch(arch)
+        bestand = join(self.get_build_dir(arch.arch), "numpy", "_core", "src", "multiarray", "unique.cpp")
+        if exists(bestand):
+            with open(bestand) as f:
+                tekst = f.read()
+            if "#include <unordered_map>" not in tekst:
+                with open(bestand, "w") as f:
+                    f.write("#include <unordered_map>\n" + tekst)
+
+
+recipe = NoodnetNumpyRecipe()
