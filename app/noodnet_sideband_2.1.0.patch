diff --git a/sbapp/sideband/noodnet_baken.py b/sbapp/sideband/noodnet_baken.py
new file mode 100644
index 0000000..937a7ee
--- /dev/null
+++ b/sbapp/sideband/noodnet_baken.py
@@ -0,0 +1,186 @@
+"""
+noodnet_baken.py - zuinig positie- en signaalbaken voor Noodnet (vervangt de plugin).
+
+Draait in de achtergronddienst van Sideband (Android) of in de app (desktop).
+Zendt alleen als er een Noodnet-kaart is EN de telefoon aangemeld is bij dat
+steunpunt. Om zendtijd te sparen:
+
+  - bij verplaatsing van minstens AFSTAND meter, maar niet vaker dan MIN_INTERVAL;
+  - anders alleen een levensteken na MAX_INTERVAL;
+  - met willekeurige spreiding, zodat telefoons rond een steunpunt niet
+    tegelijk zenden.
+
+De waarden kunnen op de kaart staan ("b": [min_s, max_s, afstand_m]); anders
+gelden de standaardwaarden hieronder.
+
+Bericht: tekst "RSSI=..;SNR=..;Q=..;BAT=.." (zoals de oude plugin), met de
+telemetrie van Sideband (positie) als veld. Niet zichtbaar in het gesprek.
+"""
+
+import json
+import math
+import os
+import random
+import threading
+import time
+
+import RNS
+
+KAART_BESTAND = "noodnet_kaart.json"
+OUDE_PLUGIN = "telemetry_beacon"
+
+MIN_INTERVAL = 600      # s: bij verplaatsing niet vaker dan dit
+MAX_INTERVAL = 1800     # s: levensteken als er niets verandert
+AFSTAND = 300           # m: wat telt als verplaatsing
+CONTROLE = 30           # s: hoe vaak er gekeken wordt
+SPREIDING = 0.15        # tot 15% willekeurige extra wachttijd
+
+
+def afstand_m(a, b):
+    """Afstand in meters tussen twee (lat, lon)-paren (haversine)."""
+    r = 6371000.0
+    la1, lo1, la2, lo2 = map(math.radians, (a[0], a[1], b[0], b[1]))
+    d = math.sin((la2 - la1) / 2) ** 2 + math.cos(la1) * math.cos(la2) * math.sin((lo2 - lo1) / 2) ** 2
+    return 2 * r * math.asin(math.sqrt(d))
+
+
+def instellingen(kaart):
+    mn, mx, af = MIN_INTERVAL, MAX_INTERVAL, AFSTAND
+    b = (kaart or {}).get("b")
+    try:
+        if b:
+            mn, mx, af = max(120, int(b[0])), max(300, int(b[1])), max(50, int(b[2]))
+    except Exception:
+        pass
+    return mn, max(mn, mx), af
+
+
+def moet_zenden(nu, laatst, vorige_pos, pos, volgende_teken, mn, af):
+    """Beslisregel (los testbaar). Geeft (zenden, reden)."""
+    if volgende_teken is not None and nu >= volgende_teken:
+        return True, "levensteken"
+    if pos is not None and nu - laatst >= mn:
+        if vorige_pos is None:
+            return True, "eerste positie"
+        if afstand_m(vorige_pos, pos) >= af:
+            return True, "verplaatst"
+    return False, ""
+
+
+class NoodnetBaken:
+    def __init__(self, sideband):
+        self.sb = sideband
+        self.draait = False
+        self.thread = None
+
+    # -- gegevens -------------------------------------------------------
+
+    def kaart(self):
+        try:
+            with open(os.path.join(self.sb.app_dir, KAART_BESTAND), "r", encoding="utf-8") as f:
+                k = json.load(f)
+            return k if isinstance(k, dict) and len(k.get("a", "")) == 32 else None
+        except Exception:
+            return None
+
+    def aangemeld(self, kaart):
+        """Status uit de kaart, of (als de app niet open was) uit de berichten van het steunpunt."""
+        if kaart.get("status") == "aangemeld":
+            return True
+        try:
+            dest = bytes.fromhex(kaart["a"])
+            status = None
+            for m in self.sb.list_messages(dest, limit=40) or []:
+                if m.get("source") != dest:
+                    continue
+                c = m.get("content", b"")
+                if isinstance(c, (bytes, bytearray)):
+                    c = c.decode("utf-8", "replace")
+                if c.startswith("Aangemeld bij") or c.startswith("U bent al aangemeld"):
+                    status = True
+                elif "niet goedgekeurd" in c or "onjuiste aanmeldcode" in c:
+                    status = False
+            return bool(status)
+        except Exception:
+            return False
+
+    def positie(self):
+        try:
+            self.sb.update_telemetry()
+            loc = self.sb.peer_location(self.sb.lxmf_destination.hash)
+            if loc and loc.get("latitude") is not None and loc.get("longitude") is not None:
+                return float(loc["latitude"]), float(loc["longitude"])
+        except Exception as e:
+            RNS.log("Noodnet-baken: positie niet beschikbaar: " + str(e), RNS.LOG_DEBUG)
+        return None
+
+    def signaal(self):
+        parts = []
+        try:
+            for interface in RNS.Transport.interfaces:
+                rssi = getattr(interface, "r_stat_rssi", None)
+                snr = getattr(interface, "r_stat_snr", None)
+                if rssi is None and snr is None:
+                    continue
+                q = getattr(interface, "r_stat_q", None)
+                if rssi is not None: parts.append("RSSI=" + str(rssi))
+                if snr is not None: parts.append("SNR=" + str(snr))
+                if q is not None: parts.append("Q=" + str(q))
+                pct = getattr(interface, "r_battery_percent", None)
+                if pct is not None and not (pct == 0 and getattr(interface, "r_battery_state", None) in (None, 0)):
+                    parts.append("BAT=" + str(pct))
+                break
+        except Exception:
+            pass
+        return ";".join(parts) if parts else "."
+
+    # -- lus --------------------------------------------------------------
+
+    def start(self):
+        if OUDE_PLUGIN in getattr(self.sb, "active_service_plugins", {}):
+            RNS.log("Noodnet-baken: de oude plugin send_Telemetry.py is actief; het ingebouwde "
+                    "baken blijft uit. Verwijder de plugin om dubbel zenden te voorkomen.", RNS.LOG_WARNING)
+            return
+        self.draait = True
+        self.thread = threading.Thread(target=self.lus, daemon=True)
+        self.thread.start()
+        RNS.log("Noodnet-baken gestart", RNS.LOG_NOTICE)
+
+    def stop(self):
+        self.draait = False
+
+    def lus(self):
+        time.sleep(20)
+        laatst = 0.0
+        vorige_pos = None
+        volgende_teken = None
+        adres = None
+        while self.draait:
+            try:
+                kaart = self.kaart()
+                if not kaart or not self.aangemeld(kaart):
+                    volgende_teken = None
+                    time.sleep(CONTROLE)
+                    continue
+                if kaart["a"] != adres:
+                    # nieuw steunpunt: geheugen wissen, eerste bericht binnen enkele minuten
+                    adres, laatst, vorige_pos = kaart["a"], time.time(), None
+                    volgende_teken = time.time() + random.uniform(30, 180)
+
+                mn, mx, af = instellingen(kaart)
+                nu = time.time()
+                pos = self.positie()
+                zenden, reden = moet_zenden(nu, laatst, vorige_pos, pos, volgende_teken, mn, af)
+                if zenden:
+                    tekst = self.signaal()
+                    self.sb.send_message(tekst, bytes.fromhex(adres), False,
+                                         skip_fields=False, no_display=True)
+                    RNS.log(f"Noodnet-baken verstuurd ({reden}; {tekst}; positie {'ja' if pos else 'nee'})",
+                            RNS.LOG_NOTICE)
+                    laatst = nu
+                    if pos is not None:
+                        vorige_pos = pos
+                    volgende_teken = nu + mx * (1 + random.uniform(0, SPREIDING))
+            except Exception as e:
+                RNS.log("Noodnet-baken: fout: " + str(e), RNS.LOG_ERROR)
+            time.sleep(CONTROLE + random.uniform(0, 5))
