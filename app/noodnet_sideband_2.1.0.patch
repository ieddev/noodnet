+try: from ui import noodnet_scan
+except ImportError: from . import noodnet_scan
+
+# Wordt overschreven door <app_dir>/methane_services.json
+# Formaat: {"Meldkamer": "<32 hex tekens LXMF-adres>", "EHBO": "..."}
+# Alleen gebruikt als er GEEN Noodnet-kaart is ingelezen.
+DEFAULT_SERVICES = {}
+
+FIELDS = [
+    ("m", "M - Groot incident?", "Ja/nee, en in een zin waarom"),
+    ("e", "E - Exacte locatie", "Adres, kruispunt of herkenningspunt"),
+    ("t", "T - Soort incident", "Brand, ongeval, instorting, ..."),
+    ("h", "H - Gevaren", "Gas, vuur, verkeer, instortingsgevaar, ..."),
+    ("a", "A - Bereikbaarheid", "Hoe kom je er, welke route is vrij"),
+    ("n", "N - Aantal slachtoffers", "Aantal en hoe ernstig"),
+    ("s", "E - Hulpdiensten", "Wie is er al, wie is er nog nodig"),
+]
+
+ROOD = (0.75, 0.05, 0.05, 1)
+GRIJS = (0.35, 0.35, 0.35, 1)
+GROEN = (0.10, 0.55, 0.20, 1)
+ORANJE = (0.85, 0.45, 0.05, 1)
+
+
+class Methane():
+    def __init__(self, app):
+        self.app = app
+        self.selected = set()
+        self.pending = None
+        self.service_buttons = {}
+        self.kaart = None
+        self.dialog = None
+        self.status_event = None
+        sm = self.app.root.ids.screen_manager
+        if not sm.has_screen("methane_screen"):
+            self.screen = Builder.load_string(layout_methane_screen)
+            self.screen.app = self
+            sm.add_widget(self.screen)
+            self.screen.ids.methane_scrollview.effect_cls = ScrollEffect
+            self.screen.bind(on_enter=lambda *a: self.on_enter(), on_leave=lambda *a: self.on_leave())
+            self.load_services()
+
+    # ------------------------------------------------------------------
+    # Algemeen
+    # ------------------------------------------------------------------
+
+    @property
+    def sb(self):
+        return self.app.sideband
+
+    def app_dir(self):
+        return self.sb.app_dir
+
+    def kaart_modus(self):
+        return self.kaart is not None
+
+    def steunpunt_bytes(self):
+        return bytes.fromhex(self.kaart["a"]) if self.kaart else None
+
+    def sluit_dialog(self, *a):
+        if self.dialog:
+            try: self.dialog.dismiss()
+            except Exception: pass
+            self.dialog = None
+
+    def melding(self, titel, tekst):
+        self.sluit_dialog()
+        ok = MDRaisedButton(text="OK", font_size=dp(18))
+        self.dialog = MDDialog(title=titel, text=tekst, buttons=[ok])
+        ok.bind(on_release=self.sluit_dialog)
+        self.dialog.open()
+
+    def on_enter(self):
+        # Positie meesturen staat bij het openen altijd uit: alleen aanzetten als je zelf ter plaatse bent
+        self.screen.ids.methane_loc.active = False
+        self.ververs_status()
+        if self.status_event is None:
+            self.status_event = Clock.schedule_interval(lambda dt: self.ververs_status(), 10)
+
+    def on_leave(self):
+        if self.status_event is not None:
+            self.status_event.cancel()
+            self.status_event = None
+
+    # ------------------------------------------------------------------
+    # Diensten: van de kaart (disciplines) of uit methane_services.json
+    # ------------------------------------------------------------------
+
+    def services_path(self):
+        return os.path.join(self.app_dir(), "methane_services.json")
+
+    def save_services(self):
+        try:
+            with open(self.services_path(), "w") as f: json.dump(self.json_services, f, indent=2)
+            return True
+        except Exception as e:
+            RNS.log("Could not save methane_services.json: "+str(e), RNS.LOG_ERROR)
+            toast("Opslaan mislukt")
+            return False
+
+    @staticmethod
+    def parse_address(text):
+        # Accepteert '<abcd...>', met spaties of dubbele punten, hoofdletters
+        hexs = "".join(c for c in text.lower() if c in "0123456789abcdef")
+        if len(hexs) != RNS.Reticulum.TRUNCATED_HASHLENGTH//8*2: return None
+        return hexs
+
+    def load_services(self):
+        self.kaart = nk.laad(self.app_dir())
+
+        json_services = dict(DEFAULT_SERVICES)
+        try:
+            path = self.services_path()
+            if os.path.isfile(path):
+                with open(path, "r") as f: json_services.update(json.load(f))
+        except Exception as e:
+            RNS.log("Could not load methane_services.json: "+str(e), RNS.LOG_ERROR)
+        self.json_services = json_services
+
+        if self.kaart_modus():
+            # Alle disciplines gaan via het steunpunt
+            self.services = {label: self.kaart["a"] for key, label in self.kaart.get("d", [])}
+        else:
+            self.services = dict(json_services)
+
+        box = self.screen.ids.methane_services
+        box.clear_widgets()
+        previous = set(self.selected)
+        self.service_buttons = {}
+        if not self.services and not self.kaart_modus():
+            toast("Lees eerst een Noodnet-kaart in, of stel een hulpdienst in")
+        for name in self.services:
+            b = MDRaisedButton(text=name, font_size=dp(17), size_hint_x=1, size_hint_y=None, height=dp(56))
+            b.bind(on_release=lambda btn, n=name: self.toggle(n))
+            self.service_buttons[name] = b
+            box.add_widget(b)
+        self.selected = set(n for n in previous if n in self.services)
+        self.refresh_selection()
+        self.ververs_status()
+
+    def first_open_check(self):
+        if not self.kaart_modus() and not self.services:
+            self.kaart_menu()
+
+    def manage_action(self, sender=None, edit=None):
+        if self.kaart_modus():
+            self.melding("Hulpdiensten",
+                         "De hulpdiensten komen van de kaart van "+self.kaart["sp"]+". "
+                         "Alle meldingen gaan via dit steunpunt.\n\n"
+                         "Wilt u weer zelf hulpdiensten met een eigen adres instellen, "
+                         "verwijder dan de kaart (kaart-knop bovenaan).")
+            return
+        # edit = naam van de dienst die bewerkt wordt (None = nieuwe dienst toevoegen)
+        content = MDBoxLayout(orientation="vertical", spacing=dp(8), size_hint_y=None)
+        rows = 0
+        for name, addr in self.json_services.items():
+            row = MDBoxLayout(orientation="horizontal", size_hint_y=None, height=dp(48))
+            mark = "  [b](wordt bewerkt)[/b]" if name == edit else ""
+            lbl = MDLabel(text=name+mark+"\n[size=12sp]"+addr[:8]+"..."+addr[-4:]+"[/size]", markup=True)
+            ed = MDIconButton(icon="pencil", pos_hint={"center_y": .5})
+            ed.bind(on_release=lambda b, n=name: self.edit_service(n, dialog))
+            dele = MDIconButton(icon="delete", pos_hint={"center_y": .5})
+            dele.bind(on_release=lambda b, n=name: self.delete_service(n, dialog))
+            row.add_widget(lbl); row.add_widget(ed); row.add_widget(dele)
+            content.add_widget(row); rows += 1
+
+        name_f = MDTextField(hint_text="Naam (bijv. Meldkamer)", font_size=dp(18),
+                             text=(edit or ""), input_type="null", keyboard_suggestions=False)
+        addr_f = MDTextField(hint_text="LXMF-adres (plak hier)", font_size=dp(16),
+                             helper_text="32 hexadecimale tekens", helper_text_mode="on_focus",
+                             text=(self.json_services[edit] if edit else ""),
+                             input_type="null", keyboard_suggestions=False)
+        content.add_widget(name_f); content.add_widget(addr_f)
+        content.height = rows*dp(56) + dp(150)
+
+        add = MDRaisedButton(text=("Opslaan" if edit else "Toevoegen"), font_size=dp(18))
+        close = MDFlatButton(text=("Annuleren" if edit else "Sluiten"), font_size=dp(18))
+        title = ("Dienst bewerken: "+edit) if edit else "Hulpdiensten beheren"
+        dialog = MDDialog(title=title, type="custom", content_cls=content, buttons=[close, add])
+        close.bind(on_release=lambda b: dialog.dismiss())
+
+        def do_add(b):
+            name = name_f.text.strip()
+            addr = self.parse_address(addr_f.text)
+            if not name: return toast("Geef een naam op")
+            if addr is None: return toast("Adres moet 32 hexadecimale tekens zijn")
+            if name in self.json_services and name != edit:
+                return toast("Er bestaat al een dienst met die naam")
+            if edit:
+                # behoud de volgorde bij hernoemen
+                self.json_services = {(name if n == edit else n): (addr if n == edit else a)
+                                      for n, a in self.json_services.items()}
+                if edit in self.selected:
+                    self.selected.discard(edit); self.selected.add(name)
+                msg = name+" opgeslagen"
+            else:
+                self.json_services[name] = addr
+                msg = name+" toegevoegd"
+            if self.save_services():
+                dialog.dismiss(); self.load_services()
+                toast(msg)
+        add.bind(on_release=do_add)
+        dialog.open()
+
+    def edit_service(self, name, dialog):
+        dialog.dismiss()
+        Clock.schedule_once(lambda dt: self.manage_action(edit=name), 0.2)
+
+    def delete_service(self, name, dialog):
+        self.json_services.pop(name, None)
+        self.selected.discard(name)
+        if self.save_services():
+            dialog.dismiss(); self.load_services()
+            toast(name+" verwijderd")
+
+    def toggle(self, name):
+        if name in self.selected: self.selected.discard(name)
+        else: self.selected.add(name)
+        self.refresh_selection()
+
+    def toggle_all(self, sender=None):
+        if not self.services: return toast("Lees eerst een Noodnet-kaart in")
+        if len(self.selected) == len(self.services): self.selected = set()
+        else: self.selected = set(self.services)
+        self.refresh_selection()
+
+    def ordered_selection(self):
+        return [n for n in self.services if n in self.selected]
+
+    def refresh_selection(self):
+        for n, b in self.service_buttons.items():
+            b.md_bg_color = ROOD if n in self.selected else GRIJS
+        names = self.ordered_selection()
+        RNS.log("M/ETHANE: gekozen diensten: "+str(names), RNS.LOG_DEBUG)
+        try:
+            if not names: txt = "Nog niets gekozen"
+            elif len(names) == len(self.services) and len(names) > 1: txt = "Gekozen: ALLE DIENSTEN ("+", ".join(names)+")"
+            else: txt = "Gekozen: "+", ".join(names)
+            self.screen.ids.methane_selected.text = txt
+        except Exception: pass
+
+    # ------------------------------------------------------------------
+    # Kaart: inlezen, aanmelden, status
+    # ------------------------------------------------------------------
+
+    def ververs_status(self):
+        try:
+            lbl = self.screen.ids.methane_kaart_status
+        except Exception:
+            return
+        self.toon_scanknop(not self.kaart_modus())
+        if not self.kaart_modus():
+            lbl.text = "Nog geen kaart van een steunpunt ingelezen."
+            lbl.text_color = GRIJS
+            return
+        try:
+            berichten = self.sb.list_messages(self.steunpunt_bytes(), limit=40)
+            nieuw = nk.status_uit_berichten(berichten, self.steunpunt_bytes())
+            if nieuw and nieuw != self.kaart.get("status"):
+                self.kaart["status"] = nieuw
+                nk.bewaar(self.app_dir(), self.kaart)
+                if nieuw == nk.STATUS_AANGEMELD: toast("Aangemeld bij "+self.kaart["sp"])
+        except Exception as e:
+            RNS.log("Noodnet: status ophalen mislukt: "+str(e), RNS.LOG_DEBUG)
+        s = self.kaart.get("status", nk.STATUS_GEEN)
+        lbl.text = nk.status_tekst(self.kaart)
+        lbl.text_color = {nk.STATUS_AANGEMELD: GROEN, nk.STATUS_WACHT: ORANJE}.get(s, ROOD)
+
+    def kaart_menu(self, sender=None):
+        self.sluit_dialog()
+        knoppen = []
+        klembord = MDFlatButton(text="Uit klembord", font_size=dp(16))
+        klembord.bind(on_release=lambda b: self.kaart_uit_klembord())
+        knoppen.append(klembord)
+        if noodnet_scan.beschikbaar():
+            scannen = MDRaisedButton(text="Kaart scannen", font_size=dp(16))
+            scannen.bind(on_release=lambda b: self.kaart_scannen())
+            knoppen.append(scannen)
+        if self.kaart_modus():
+            opnieuw = MDFlatButton(text="Opnieuw aanmelden", font_size=dp(16))
+            opnieuw.bind(on_release=lambda b: (self.sluit_dialog(), self.vraag_naam(self.kaart, self.kaart.get("band"))))
+            weg = MDFlatButton(text="Kaart verwijderen", font_size=dp(16))
+            weg.bind(on_release=lambda b: self.kaart_verwijderen())
+            knoppen = [weg, opnieuw] + knoppen
+            band = self.kaart.get("band")
+            radio = nk.kies_radio(self.kaart, band)
+            tekst = (self.kaart["sp"] + (" ("+self.kaart["g"]+")" if self.kaart.get("g") else "") + "\n"
+                     + nk.status_tekst(self.kaart) + "\n\n"
+                     + ("RNode: "+nk.radio_tekst(radio)+"\n" if radio else "")
+                     + ("Naam: "+self.kaart.get("naam", "")+"\n" if self.kaart.get("naam") else "")
+                     + "\nNieuwe kaart? Tik op 'Kaart scannen'.")
+        else:
+            tekst = ("Scan de QR-code op de kaart van het steunpunt.\n\n"
+                     "Lukt scannen niet? Scan met een andere app, kopieer de tekst "
+                     "en tik op 'Uit klembord'.")
+        sluit = MDFlatButton(text="Sluiten", font_size=dp(16))
+        sluit.bind(on_release=self.sluit_dialog)
+        self.dialog = MDDialog(title="Noodnet-kaart", text=tekst, buttons=[sluit] + knoppen)
+        self.dialog.open()
+
+    def kaart_uit_klembord(self):
+        self.sluit_dialog()
+        try:
+            from kivy.core.clipboard import Clipboard
+            tekst = Clipboard.paste()
+        except Exception:
+            tekst = ""
+        self.kaart_inlezen(tekst, "klembord")
+
+    def kaart_scannen(self, sender=None):
+        self.sluit_dialog()
+        if not noodnet_scan.beschikbaar():
+            self.melding("Scannen niet mogelijk",
+                         "Deze telefoon heeft de scanner van Google niet. Scan de QR-code met een "
+                         "andere app, kopieer de tekst en kies 'Uit klembord' onder het kaart-icoon.")
+            return
+        noodnet_scan.scan(lambda tekst: self.kaart_inlezen(tekst, "scan"),
+                          lambda melding: self.melding("Scannen mislukt", melding))
+
+    def scan_mogelijk(self):
+        return noodnet_scan.beschikbaar()
+
+    def toon_scanknop(self, zichtbaar):
+        try:
+            knop = self.screen.ids.methane_scan_knop
+        except Exception:
+            return
+        knop.opacity = 1 if zichtbaar else 0
+        knop.disabled = not zichtbaar
+        knop.height = dp(56) if zichtbaar else 0
+
+    def kaart_verwijderen(self):
+        self.sluit_dialog()
+        nk.verwijder(self.app_dir())
+        self.selected = set()
+        self.load_services()
+        toast("Kaart verwijderd")
+
+    def kaart_inlezen(self, tekst, bron="link"):
+        """Begin van de aanmeldflow: kaart lezen, radio kiezen, naam vragen."""
+        RNS.log("Noodnet: kaart inlezen via "+str(bron), RNS.LOG_DEBUG)
+        try:
+            kaart = nk.lees_kaart(tekst)
+        except nk.KaartFout as e:
+            self.melding("Kaart niet gelezen", str(e))
+            return
+        self.sluit_dialog()
+        titel = "Kaart van "+kaart["sp"]
+        uitleg = ("Gemeente "+kaart["g"]+"\n" if kaart.get("g") else "") + \
+                 "Hulpdiensten: "+", ".join(l for k, l in kaart["d"])+"\n\n"
+        annuleer = MDFlatButton(text="Annuleren", font_size=dp(16))
+        annuleer.bind(on_release=self.sluit_dialog)
+        radios = kaart.get("r", [])
+        if len(radios) > 1:
+            uitleg += "Welke RNode heeft u gekregen?"
+            knoppen = [annuleer]
+            for r in radios:
+                b = MDRaisedButton(text=r["band"]+" MHz", font_size=dp(16))
+                b.bind(on_release=lambda x, band=r["band"]: (self.sluit_dialog(), self.vraag_naam(kaart, band)))
+                knoppen.append(b)
+        else:
+            if radios:
+                uitleg += "De RNode wordt ingesteld op "+nk.radio_tekst(radios[0])+"."
+            ok = MDRaisedButton(text="Verder", font_size=dp(16))
+            band = radios[0]["band"] if radios else None
+            ok.bind(on_release=lambda x: (self.sluit_dialog(), self.vraag_naam(kaart, band)))
+            knoppen = [annuleer, ok]
+        self.dialog = MDDialog(title=titel, text=uitleg, buttons=knoppen)
+        self.dialog.open()
+
+    def vraag_naam(self, kaart, band):
+        vorige = (self.kaart or {}).get("naam") or ""
+        if not vorige:
+            dn = self.sb.config.get("display_name", "")
+            if dn and dn != "Anonymous Peer": vorige = dn
+        content = MDBoxLayout(orientation="vertical", spacing=dp(8), size_hint_y=None, height=dp(90))
+        naam_f = MDTextField(hint_text="Uw naam", font_size=dp(18), text=vorige,
+                             input_type="null", keyboard_suggestions=False)
+        content.add_widget(naam_f)
+        annuleer = MDFlatButton(text="Annuleren", font_size=dp(16))
+        annuleer.bind(on_release=self.sluit_dialog)
+        ok = MDRaisedButton(text="AANMELDEN", font_size=dp(16), md_bg_color=ROOD)
+        def go(b):
+            naam = " ".join(naam_f.text.split())
+            if not naam: return toast("Vul uw naam in")
+            self.sluit_dialog()
+            self.kaart_toepassen(kaart, band, naam)
+        ok.bind(on_release=go)
+        self.dialog = MDDialog(title="Aanmelden bij "+kaart["sp"], type="custom", content_cls=content,
+                               buttons=[annuleer, ok])
+        self.dialog.open()
+
+    def kaart_toepassen(self, kaart, band, naam):
+        cfg = self.sb.config
+        radio = nk.kies_radio(kaart, band)
+        veranderd = False
+        if radio:
+            veranderd = nk.pas_radio_toe(cfg, radio, kaart.get("i"))
+        if cfg.get("display_name", "Anonymous Peer") == "Anonymous Peer":
+            cfg["display_name"] = naam
+        # Positie voor meldingen en het baken: telemetrie met locatie aan
+        if not cfg.get("telemetry_enabled"):
+            cfg["telemetry_enabled"] = True
+            veranderd = True
+        if not cfg.get("telemetry_s_location") and not cfg.get("telemetry_s_fixed_location"):
+            cfg["telemetry_s_location"] = True
+            veranderd = True
+        try:
+            self.app.request_location_permissions()
+        except Exception:
+            pass
+        try: self.sb.save_configuration()
+        except Exception as e: RNS.log("Noodnet: config opslaan mislukt: "+str(e), RNS.LOG_ERROR)
+
+        oude = self.kaart or {}
+        kaart = dict(kaart)
+        kaart["band"] = band
+        kaart["naam"] = naam
+        kaart["status"] = oude.get("status") if oude.get("a") == kaart["a"] else nk.STATUS_GEEN
+        if kaart["status"] == nk.STATUS_AFGEWEZEN: kaart["status"] = nk.STATUS_GEEN
+        kaart["ingelezen"] = time.strftime("%Y-%m-%d %H:%M")
+        nk.bewaar(self.app_dir(), kaart)
+        self.selected = set()
+        self.load_services()
+
+        dest = self.steunpunt_bytes()
+        try:
+            if not self.sb.has_conversation(dest):
+                self.sb.create_conversation(dest, name=kaart["sp"])
+                self.sb.setstate("app.flags.new_conversations", True)
+            # positie meesturen in berichten aan het steunpunt (melding en baken)
+            self.sb.send_telemetry_in_conversation(dest)
+        except Exception as e:
+            RNS.log("Noodnet: gesprek aanmaken mislukt: "+str(e), RNS.LOG_ERROR)
+
+        def na_herstart():
+            self.stuur_aanmelding(kaart, naam)
+
+        if veranderd:
+            toast("RNode-instellingen opgeslagen. De radio wordt opnieuw gestart...")
+            def job():
+                ok = False
+                try: ok = self.app.restart_service()
+                except Exception as e: RNS.log("Noodnet: herstart mislukt: "+str(e), RNS.LOG_ERROR)
+                def verder(dt):
+                    if not ok: toast("Herstart van de radio mislukt; probeer het later opnieuw")
+                    na_herstart()
+                Clock.schedule_once(verder, 0.5)
+            threading.Thread(target=job, daemon=True).start()
+        else:
+            na_herstart()
+
+    def stuur_aanmelding(self, kaart, naam):
+        dest = bytes.fromhex(kaart["a"])
+        toast("Steunpunt zoeken...")
+        def job():
+            gevonden = False
+            for i in range(60):
+                try:
+                    if RNS.Identity.recall(dest):
+                        gevonden = True
+                        break
+                    if i % 15 == 0:
+                        RNS.Transport.request_path(dest)
+                except Exception:
+                    pass
+                time.sleep(1)
+            def verder(dt):
+                if not gevonden:
+                    self.melding("Steunpunt niet bereikbaar",
+                                 kaart["sp"]+" is nog niet gevonden via de radio.\n\n"
+                                 "Controleer of de RNode gekoppeld en aan is, en of u binnen bereik bent. "
+                                 "Probeer daarna 'Opnieuw aanmelden' via het kaart-icoon.")
+                    return
+                ok = self.sb.send_message(nk.aanmeld_tekst(kaart, naam), dest, False)
+                if ok is False:
+                    toast("Aanmelding versturen mislukt; probeer 'Opnieuw aanmelden'")
+                    return
+                k = nk.laad(self.app_dir()) or kaart
+                if k.get("status") != nk.STATUS_AANGEMELD:
+                    k["status"] = nk.STATUS_WACHT
+                k["aanmelding_verstuurd"] = time.strftime("%Y-%m-%d %H:%M")
+                nk.bewaar(self.app_dir(), k)
+                self.kaart = k
+                self.ververs_status()
+                self.melding("Aanmelding verstuurd",
+                             "Uw aanmelding is verstuurd naar "+kaart["sp"]+".\n\n"
+                             "De zendamateur keurt deze goed. U ziet de bevestiging bovenaan dit "
+                             "scherm en in het gesprek met het steunpunt.")
+            Clock.schedule_once(verder, 0)
