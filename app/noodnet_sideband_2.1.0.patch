+"""
+noodnet_kaart.py - logica voor de Noodnet-aanmeldkaart (zonder Kivy, testbaar).
+
+De kaart van een Noodsteunpunt bevat een QR-code met een link:
+
+    noodnet://kaart?d=<base64url van JSON>
+
+of (oudere kaarten) de tekst  NN1:{json}
+
+JSON-velden:
+    v   versie (1)
+    g   gemeente
+    sp  naam van het steunpunt
+    a   LXMF-adres van het steunpunt (32 hex-tekens)
+    c   aanmeldcode
+    r   lijst radio's: {"band","f","bw","sf","cr","p"}
+    d   disciplines: [[sleutel, label], ...]
+    i   optioneel [ifac_netwerknaam, ifac_wachtwoord]
+    b   optioneel baken [min_interval_s, max_interval_s, afstand_m]
+"""
+
+import base64
+import json
+import os
+import re
+import time
+from urllib.parse import urlparse, parse_qs
+
+KAART_BESTAND = "noodnet_kaart.json"
+ADRES_LENGTE = 32
+
+STATUS_GEEN = "geen"
+STATUS_WACHT = "wacht"            # aanmelding verstuurd, wacht op goedkeuring
+STATUS_AANGEMELD = "aangemeld"
+STATUS_AFGEWEZEN = "afgewezen"
+
+
+class KaartFout(ValueError):
+    pass
+
+
+# ---------------------------------------------------------------------------
+# Lezen
+# ---------------------------------------------------------------------------
+
+def _b64url_decode(s):
+    s = s.strip()
+    s += "=" * (-len(s) % 4)
+    return base64.urlsafe_b64decode(s.encode("ascii")).decode("utf-8")
+
+
+def maak_link(data):
+    """Maakt de noodnet://-link (gebruikt door maak_kaart.py)."""
+    js = json.dumps(data, ensure_ascii=False, separators=(",", ":"))
+    b = base64.urlsafe_b64encode(js.encode("utf-8")).decode("ascii").rstrip("=")
+    return "noodnet://kaart?d=" + b
+
+
+def is_kaart_tekst(text):
+    t = (text or "").strip().lower()
+    return t.startswith("noodnet:") or t.startswith("nn1:")
+
+
+def lees_kaart(text):
+    """Leest een kaart uit een link of QR-tekst. Geeft een gecontroleerde dict."""
+    if not text or not text.strip():
+        raise KaartFout("Leeg: er staat geen kaart op het klembord")
+    t = text.strip()
+    try:
+        if t.lower().startswith("noodnet:"):
+            u = urlparse(t)
+            q = parse_qs(u.query)
+            if "d" not in q:
+                raise KaartFout("Link bevat geen kaartgegevens")
+            raw = _b64url_decode(q["d"][0])
+        elif t.lower().startswith("nn1:"):
+            raw = t[4:]
+        elif t.startswith("{"):
+            raw = t
+        else:
+            raise KaartFout("Dit is geen Noodnet-kaart")
+        data = json.loads(raw)
+    except KaartFout:
+        raise
+    except Exception as e:
+        raise KaartFout(f"Kaart kan niet gelezen worden ({e.__class__.__name__})")
+    return controleer(data)
+
+
+def controleer(data):
+    if not isinstance(data, dict):
+        raise KaartFout("Onjuist kaartformaat")
+    if int(data.get("v", 1)) != 1:
+        raise KaartFout("Deze kaart is voor een nieuwere versie van de app")
+    adres = "".join(c for c in str(data.get("a", "")).lower() if c in "0123456789abcdef")
+    if len(adres) != ADRES_LENGTE:
+        raise KaartFout("Adres van het steunpunt ontbreekt of is onjuist")
+    if not str(data.get("sp", "")).strip():
+        raise KaartFout("Naam van het steunpunt ontbreekt")
+    radios = []
+    for r in data.get("r", []) or []:
+        try:
+            radios.append({"band": str(r.get("band", "")), "f": int(r["f"]), "bw": int(r["bw"]),
+                           "sf": int(r["sf"]), "cr": int(r["cr"]),
+                           "p": int(r["p"]) if r.get("p") is not None else None})
+        except (KeyError, TypeError, ValueError):
+            raise KaartFout("Radio-instellingen op de kaart zijn onvolledig")
+    disciplines = []
+    for d in data.get("d", []) or []:
+        if isinstance(d, (list, tuple)) and len(d) >= 2:
+            disciplines.append([str(d[0]), str(d[1])])
+        elif isinstance(d, str):
+            disciplines.append([d.lower(), d])
+    ifac = data.get("i")
+    if ifac is not None:
+        if not (isinstance(ifac, (list, tuple)) and len(ifac) == 2):
+            raise KaartFout("IFAC-gegevens op de kaart zijn onjuist")
+        ifac = [str(ifac[0]), str(ifac[1])]
+    baken = None
+    b = data.get("b")
+    if isinstance(b, (list, tuple)) and len(b) == 3:
+        try:
+            baken = [int(b[0]), int(b[1]), int(b[2])]
+        except (TypeError, ValueError):
+            baken = None
+    uit = {"v": 1, "g": str(data.get("g", "")), "sp": str(data["sp"]).strip(), "a": adres,
+           "c": str(data.get("c", "")).strip(), "r": radios, "d": disciplines, "i": ifac}
+    if baken:
+        uit["b"] = baken
+    return uit
+
+
+# ---------------------------------------------------------------------------
+# Opslaan (in de map van Sideband)
+# ---------------------------------------------------------------------------
+
+def pad(app_dir):
+    return os.path.join(app_dir, KAART_BESTAND)
+
+
+def laad(app_dir):
+    try:
+        with open(pad(app_dir), "r", encoding="utf-8") as f:
+            data = json.load(f)
+        return data if isinstance(data, dict) and data.get("a") else None
+    except (OSError, ValueError):
+        return None
+
+
+def bewaar(app_dir, data):
+    tmp = pad(app_dir) + ".tmp"
+    with open(tmp, "w", encoding="utf-8") as f:
+        json.dump(data, f, ensure_ascii=False, indent=2)
+    os.replace(tmp, pad(app_dir))
+
+
+def verwijder(app_dir):
+    try:
+        os.remove(pad(app_dir))
+        return True
+    except OSError:
+        return False
+
+
+# ---------------------------------------------------------------------------
+# Radio-instellingen in de Sideband-config zetten
+# ---------------------------------------------------------------------------
+
+def kies_radio(kaart, band=None):
+    radios = kaart.get("r", [])
+    if not radios:
+        return None
+    if band is not None:
+        for r in radios:
+            if r["band"] == str(band):
+                return r
+    return radios[0] if len(radios) == 1 else None
+
+
+def pas_radio_toe(config, radio, ifac=None):
+    """Zet de RNode-instellingen in de Sideband-config (dict).
+    Geeft True als er iets veranderd is (dan moet de radio-service herstarten)."""
+    nieuw = {
+        "connect_rnode": True,
+        "hw_rnode_frequency": radio["f"],
+        "hw_rnode_bandwidth": radio["bw"],
+        "hw_rnode_spreading_factor": radio["sf"],
+        "hw_rnode_coding_rate": radio["cr"],
+        # ISM-banden: maximaal 10% zendtijd
+        "hw_rnode_atl_long": 10.0,
+    }
+    if radio.get("p") is not None:
+        nieuw["hw_rnode_tx_power"] = radio["p"]
+    if ifac:
+        nieuw["connect_rnode_ifac_netname"] = ifac[0]
+        nieuw["connect_rnode_ifac_passphrase"] = ifac[1]
+    else:
+        nieuw["connect_rnode_ifac_netname"] = ""
+        nieuw["connect_rnode_ifac_passphrase"] = ""
+    veranderd = any(config.get(k) != v for k, v in nieuw.items())
+    config.update(nieuw)
+    return veranderd
+
+
+def radio_tekst(radio):
+    t = f"{radio['f'] / 1e6:.3f} MHz, BW {radio['bw'] // 1000} kHz, SF {radio['sf']}, CR {radio['cr']}"
+    if radio.get("p") is not None:
+        t += f", {radio['p']} dBm"
+    return t
+
+
+# ---------------------------------------------------------------------------
+# Aanmelden en status
+# ---------------------------------------------------------------------------
+
+def aanmeld_tekst(kaart, naam):
+    return f"AANMELDEN {kaart.get('c', '')} {naam}".strip()
+
+
+def status_uit_berichten(berichten, steunpunt_adres_bytes):
+    """Bepaalt de aanmeldstatus uit de berichten van het gesprek met het steunpunt.
+    'berichten' zoals sideband.list_messages() ze geeft (oud -> nieuw)."""
+    status = None
+    for m in berichten:
+        if m.get("source") != steunpunt_adres_bytes:
+            continue
+        c = m.get("content", b"")
+        if isinstance(c, (bytes, bytearray)):
+            c = c.decode("utf-8", "replace")
+        if c.startswith("Aangemeld bij") or c.startswith("U bent al aangemeld"):
+            status = STATUS_AANGEMELD
+        elif "niet goedgekeurd" in c:
+            status = STATUS_AFGEWEZEN
+        elif c.startswith("Aanmelding ontvangen"):
+            if status != STATUS_AANGEMELD:
+                status = STATUS_WACHT
+        elif "onjuiste aanmeldcode" in c:
+            status = STATUS_GEEN
+    return status
+
+
+def status_tekst(kaart):
+    s = kaart.get("status", STATUS_GEEN)
+    sp = kaart.get("sp", "het steunpunt")
+    return {
+        STATUS_AANGEMELD: f"Aangemeld bij {sp}",
+        STATUS_WACHT: f"Wacht op goedkeuring door de zendamateur ({sp})",
+        STATUS_AFGEWEZEN: f"Aanmelding bij {sp} is afgewezen",
+    }.get(s, f"Nog niet aangemeld bij {sp}")
+
+
+# ---------------------------------------------------------------------------
+# Melding opbouwen
+# ---------------------------------------------------------------------------
+
+def locatie_regel(locatie):
+    """locatie: dict met latitude/longitude (en eventueel accuracy), of None."""
+    if not locatie:
+        return None
+    try:
+        lat, lon = float(locatie["latitude"]), float(locatie["longitude"])
+    except (KeyError, TypeError, ValueError):
+        return None
+    t = f"LOCATIE: {lat:.5f}, {lon:.5f}"
+    acc = locatie.get("accuracy")
+    try:
+        if acc is not None and float(acc) > 0:
+            t += f" (±{round(float(acc))} m)"
+    except (TypeError, ValueError):
+        pass
+    return t
+
+
+_LOC_RE = re.compile(r"^\s*LOCATIE\s*:\s*(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)(?:\s*\(±\s*(\d+(?:\.\d+)?)\s*m\))?", re.I | re.M)
+
+
+def lees_locatie_regel(text):
+    """Geeft (lat, lon, nauwkeurigheid) uit een 'LOCATIE:'-regel, of None."""
+    m = _LOC_RE.search(text or "")
+    if not m:
+        return None
+    lat, lon = float(m.group(1)), float(m.group(2))
+    if not (-90 <= lat <= 90 and -180 <= lon <= 180):
+        return None
+    return lat, lon, (float(m.group(3)) if m.group(3) else None)
+
+
+def bouw_melding(code, ontvangers, velden, locatie=None, tijd=None):
+    """velden: lijst van (letter, waarde) in M-E-T-H-A-N-E-volgorde."""
+    ts = time.strftime("%Y-%m-%d %H:%M", time.localtime(tijd)) if tijd else time.strftime("%Y-%m-%d %H:%M")
+    kop = ["M/ETHANE MELDING " + ts, "MELDCODE: " + code, "GEMELD AAN: " + ", ".join(ontvangers)]
+    lr = locatie_regel(locatie)
+    if lr:
+        kop.append(lr)          # in de kop, zodat het M/ETHANE-formulier niet verandert
+    return "\n".join(kop + [f"{letter}: {waarde or 'onbekend'}" for letter, waarde in velden])
