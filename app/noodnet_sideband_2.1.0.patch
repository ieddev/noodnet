+"""
+noodnet_scan.py - QR-code scannen vanuit de app (Android).
+
+Gebruikt de Google Code Scanner (Google Play-services, module
+play-services-code-scanner). Google toont het scanscherm zelf; de app
+heeft daarvoor geen camerarechten nodig en krijgt alleen de tekst terug.
+
+Gebruik:
+    if noodnet_scan.beschikbaar():
+        noodnet_scan.scan(op_tekst, op_fout)
+
+op_tekst(tekst) en op_fout(melding) worden op de Kivy-thread aangeroepen.
+Bij annuleren door de gebruiker wordt geen van beide aangeroepen.
+"""
+
+import RNS
+from kivy.clock import Clock
+
+_SCANNER_KLASSE = "com.google.mlkit.vision.codescanner.GmsBarcodeScanning"
+
+# Houd de Java-listeners vast zolang de scan loopt (anders ruimt Python ze op)
+_actief = []
+
+
+def op_android():
+    try:
+        return RNS.vendor.platformutils.is_android()
+    except Exception:
+        return False
+
+
+def beschikbaar():
+    """True als de scanner in deze app zit (Android + bibliotheek aanwezig)."""
+    if not op_android():
+        return False
+    try:
+        from jnius import autoclass
+        autoclass(_SCANNER_KLASSE)
+        return True
+    except Exception as e:
+        RNS.log("Noodnet: QR-scanner niet beschikbaar: " + str(e), RNS.LOG_DEBUG)
+        return False
+
+
+def scan(op_tekst, op_fout):
+    try:
+        from jnius import autoclass, cast, PythonJavaClass, java_method
+        from android import mActivity
+    except Exception as e:
+        Clock.schedule_once(lambda dt: op_fout("Scannen kan alleen op Android (" + str(e) + ")"), 0)
+        return
+
+    class _Gelukt(PythonJavaClass):
+        __javainterfaces__ = ["com/google/android/gms/tasks/OnSuccessListener"]
+        __javacontext__ = "app"
+
+        @java_method("(Ljava/lang/Object;)V")
+        def onSuccess(self, resultaat):
+            tekst = None
+            try:
+                barcode = cast("com.google.mlkit.vision.barcode.common.Barcode", resultaat)
+                tekst = barcode.getRawValue()
+            except Exception as e:
+                RNS.log("Noodnet: QR-resultaat niet te lezen: " + str(e), RNS.LOG_ERROR)
+            _klaar()
+            if tekst:
+                Clock.schedule_once(lambda dt: op_tekst(str(tekst)), 0)
+            else:
+                Clock.schedule_once(lambda dt: op_fout("De QR-code bevat geen tekst"), 0)
+
+    class _Mislukt(PythonJavaClass):
+        __javainterfaces__ = ["com/google/android/gms/tasks/OnFailureListener"]
+        __javacontext__ = "app"
+
+        @java_method("(Ljava/lang/Exception;)V")
+        def onFailure(self, fout):
+            try:
+                melding = str(fout.getMessage())
+            except Exception:
+                melding = "onbekende fout"
+            RNS.log("Noodnet: QR-scan mislukt: " + melding, RNS.LOG_ERROR)
+            _klaar()
+            Clock.schedule_once(lambda dt: op_fout(_uitleg(melding)), 0)
+
+    class _Geannuleerd(PythonJavaClass):
+        __javainterfaces__ = ["com/google/android/gms/tasks/OnCanceledListener"]
+        __javacontext__ = "app"
+
+        @java_method("()V")
+        def onCanceled(self):
+            RNS.log("Noodnet: QR-scan geannuleerd", RNS.LOG_DEBUG)
+            _klaar()
+
+    try:
+        GmsBarcodeScanning = autoclass(_SCANNER_KLASSE)
+        Builder = autoclass("com.google.mlkit.vision.codescanner.GmsBarcodeScannerOptions$Builder")
+        opties = Builder().enableAutoZoom().build()
+        scanner = GmsBarcodeScanning.getClient(mActivity, opties)
+        taak = scanner.startScan()
+        luisteraars = (_Gelukt(), _Mislukt(), _Geannuleerd())
+        _actief.append(luisteraars)
+        taak.addOnSuccessListener(luisteraars[0])
+        taak.addOnFailureListener(luisteraars[1])
+        taak.addOnCanceledListener(luisteraars[2])
+    except Exception as e:
+        RNS.log("Noodnet: QR-scanner starten mislukt: " + str(e), RNS.LOG_ERROR)
+        Clock.schedule_once(lambda dt: op_fout(_uitleg(str(e))), 0)
+
+
+def _klaar():
+    if _actief:
+        _actief.pop(0)
+
+
+def _uitleg(melding):
+    m = (melding or "").lower()
+    if "module" in m or "download" in m or "unavailable" in m or "api" in m:
+        return ("De scanner van Google is nog niet klaar of niet beschikbaar op deze telefoon. "
+                "Probeer het over een minuut opnieuw (de eerste keer wordt hij gedownload, "
+                "internet nodig), of scan met een andere app en gebruik 'Uit klembord'.")
+    return "Scannen lukt niet (" + melding + "). Gebruik een scan-app en 'Uit klembord'."
