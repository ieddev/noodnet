[Unit]
Description=Noodnet bijwerken (gestart vanaf de beheerpagina)
After=network-online.target

[Service]
Type=oneshot
# Als root, zodat sudo geen wachtwoord vraagt; de installatie zelf draait als @GEBRUIKER@
ExecStart=/bin/bash /usr/local/lib/noodnet/noodnet-bijwerken.sh @GEBRUIKER@ @MAP@
TimeoutStartSec=90min
# Niet stoppen als de installatie de beheerpagina en andere diensten herstart
KillMode=process
