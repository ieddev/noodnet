[Unit]
Description=Noodnet: wifi-hotspot (hostapd)
After=NetworkManager.service sys-subsystem-net-devices-wlan0.device
Wants=sys-subsystem-net-devices-wlan0.device
ConditionPathExists=/etc/noodnet/hostapd.conf

[Service]
Type=simple
# NetworkManager laat wlan0 los (alleen tot de herstart; 'hotspot.sh thuiswifi' zet hem terug)
ExecStartPre=-nmcli dev set wlan0 managed no
ExecStartPre=-rfkill unblock wifi
ExecStartPre=-ip addr flush dev wlan0
ExecStartPre=ip addr add 10.42.0.1/24 dev wlan0
ExecStart=hostapd /etc/noodnet/hostapd.conf
ExecStopPost=-ip addr flush dev wlan0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
