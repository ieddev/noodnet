[Unit]
Description=Direwolf (Noodnet, 2 m)
After=sound.target network.target

[Service]
Type=simple
User=@GEBRUIKER@
WorkingDirectory=@MAP@
ExecStartPre=-/usr/bin/python3 @MAP@/noodnet_radio.py --niveau
ExecStart=/usr/bin/direwolf -c @MAP@/direwolf.conf -t 0 -q d
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
